# =============================================================================
# StockSaathi — backend email config
# Copy this file to `.env` (same folder) and fill in ONE of the two options.
# =============================================================================

# --- Option A: Gmail / any SMTP --------------------------------------------
# For Gmail, create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be ON)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=StockSaathi <your.email@gmail.com>

# --- Option B: Resend.com (simpler; no SMTP) -------------------------------
# Sign up at https://resend.com (free 3000 emails/month).
# You can use the test sender onboarding@resend.dev without verifying a domain.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RESEND_FROM=StockSaathi <onboarding@resend.dev>

# --- Optional --------------------------------------------------------------
# STOCKSAATHI_PORT=7348
