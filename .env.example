# =============================================================================
# StockSaathi — backend email config
# Copy this file to `.env` (same folder) and fill in ONE of the two options.
# =============================================================================

# --- Option A: Resend with verified custom domain (RECOMMENDED) ------------
# 1. Sign up at https://resend.com (free 3000/mo, unlimited on paid).
# 2. Domains → Add Domain → stocksaathi.co.in → add the 3 DNS records they show.
# 3. Once verified, emails send from accounts@stocksaathi.co.in to ANY inbox.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RESEND_FROM=StockSaathi <accounts@stocksaathi.co.in>

# --- Option B: Gmail / any SMTP (fallback) ---------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# SMTP_FROM=StockSaathi <your.email@gmail.com>

# --- Optional --------------------------------------------------------------
# STOCKSAATHI_PORT=7348

# --- Supabase (required for cross-device mode) -----------------------------
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGc...
# Service-role key — server-only, NEVER in frontend. Enables /api/live-quote
# to upsert into quote_cache so hundreds of users share one cached feed.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# --- Live market data (optional, replaces Yahoo primary) --------------------
# DhanHQ REST API — free with a Dhan account at dhan.co. When both vars are
# set, /api/live-quote tries Dhan first, Yahoo as fallback.
# DHAN_ACCESS_TOKEN=eyJ...
# DHAN_CLIENT_ID=1100XXXXXX

# --- Coach LLM (optional) --------------------------------------------------
# The chatbot uses Groq's free Llama 3.3 70B (blazing fast, free tier).
# Sign up at https://console.groq.com/keys (no credit card)
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# (Groq is the only LLM the backend talks to; BYO-key UI path is client-side only.)

# Rate limits
# RATE_LIMIT_PER_HOUR=20
# CHAT_RATE_PER_HOUR=120
